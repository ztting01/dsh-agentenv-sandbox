{
  "name": "dsh-agentenv-sandbox",
  "version": "0.1.5",
  "description": "AgentENV execution-world bundle for DeepSeek Harness",
  "homepage": "https://github.com/ztting01/dsh-agentenv-sandbox#readme",
  "bugs": {
    "url": "https://github.com/ztting01/dsh-agentenv-sandbox/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ztting01/dsh-agentenv-sandbox.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./workspace": {
      "types": "./lib/workspace.d.ts",
      "default": "./lib/workspace.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "sandbox/Dockerfile",
    "scripts/agentenv-smoke.mjs",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run test && npm run build",
    "smoke:agentenv": "node scripts/agentenv-smoke.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@deepseek-ai/dsh-e2b": "0.1.0-rc.7",
    "@deepseek-ai/dsh-fs-e2b": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subprocess-e2b": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "e2b": "2.29.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "license": "MIT"
}
